# ==========================================
# Nandha Kumar's Portfolio AI Chatbot Config
# ==========================================

# AI Provider: 'openai', 'gemini', or 'groq'
AI_PROVIDER=openai

# Your Secret API Key (Keep this secret! Never commit .env to GitHub)
# Example for OpenAI: sk-...
# Example for Gemini: AIzaSy...
# Example for Groq: gsk_...
AI_API_KEY=your_api_key_here

# AI Model Name (Optional, defaults based on provider)
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# For Gemini: gemini-1.5-flash, gemini-2.0-flash
# For Groq: llama-3.1-8b-instant, llama-3.3-70b-versatile
AI_MODEL=gpt-4o-mini

# Response creativity (0.0 to 1.0, 0.2-0.3 recommended for factual portfolio answers)
AI_TEMPERATURE=0.3

# Maximum tokens per response
AI_MAX_TOKENS=750
